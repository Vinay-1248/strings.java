public class DetectCapital {
    public static boolean detectCapitalUse(String word) {
        int upperCount = 0;

        for (int i = 0; i < word.length(); i++) {
            if (Character.isUpperCase(word.charAt(i))) {
                upperCount++;
            }
        }

        // Valid if:
        // 1. All letters are uppercase (upperCount == word.length())
        // 2. All letters are lowercase (upperCount == 0)
        // 3. Only the first letter is uppercase (upperCount == 1 && first char is uppercase)
        return upperCount == word.length() 
            || upperCount == 0 
            || (upperCount == 1 && Character.isUpperCase(word.charAt(0)));
    }

    public static void main(String[] args) {
        System.out.println(detectCapitalUse("USA"));    // Output: true
        System.out.println(detectCapitalUse("FlaG"));   // Output: false
        System.out.println(detectCapitalUse("Google")); // Output: true
    }
}
